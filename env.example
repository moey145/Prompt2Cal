# OpenAI API Key (used by the research harness and as a fallback parser)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key — live Chrome extension parser (Claude Sonnet 4.6)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
LLM_PROVIDER=claude
LLM_MODEL=claude-sonnet-4-6

# Google Calendar API Configuration
# You'll need to create a Google Cloud Project and enable the Calendar API
# Get these from your Google Cloud Console OAuth 2.0 Client credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# Microsoft Outlook / Graph Calendar (Chrome extension)
# Register an app at https://portal.azure.com → App registrations
MS_CLIENT_ID=your_microsoft_client_id_here
MS_CLIENT_SECRET=your_microsoft_client_secret_here
MS_TENANT_ID=common
MS_REDIRECT_URI=http://localhost:8000/auth/microsoft/callback

# Optional: Custom port for the FastAPI server
PORT=8000
