{
  "manifest_version": 3,
  "name": "Prompt2Cal - Natural Language Calendar",
  "version": "1.2.0",
  "description": "Turn plain-English plans into Google Calendar or Outlook events. Type, speak or right-click text, then review before it's added.",
  "permissions": [
    "activeTab",
    "identity",
    "storage",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "https://prompt2cal-backend-139801429107.us-central1.run.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup-react.html",
    "default_title": "Prompt2Cal",
    "default_icon": {
      "16": "assets/Logo.png",
      "32": "assets/Logo.png",
      "48": "assets/Logo.png",
      "128": "assets/Logo.png"
    }
  },
  "icons": {
    "16": "assets/Logo.png",
    "32": "assets/Logo.png",
    "48": "assets/Logo.png",
    "128": "assets/Logo.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "popup-react.html",
        "icons/Logo.svg",
        "icons/DarkModeLogo.svg"
      ],
      "matches": [
        "https://*/*",
        "http://*/*"
      ]
    }
  ]
}